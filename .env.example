APP_NAME=Leaf Online Store
APP_ENV=production
DEBUG=false
BASE_URL=https://leaf.ads-ai.in
HOST=127.0.0.1
PORT=8070
DATABASE_URL=postgresql+psycopg2://leaf_store_user:CHANGE_ME@127.0.0.1:5432/leaf_store_db
SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
SESSION_SECRET_KEY=GENERATE_ANOTHER_LONG_RANDOM_SECRET
SESSION_COOKIE_NAME=leaf_admin_session
SESSION_MAX_AGE=28800
UPLOAD_DIR=/opt/leaf-store/app/uploads
MAX_UPLOAD_SIZE_MB=10
UPI_ENABLED=false
UPI_VPA=merchant@bank
UPI_PAYEE_NAME=Leaf Online Store
